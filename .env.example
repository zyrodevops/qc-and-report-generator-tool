# ==============================================================================
# Marine Cargo Survey & QC Platform - Environment Configuration Example
# Copy to .env and configure for environment. NEVER commit .env to repository.
# ==============================================================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=marine_survey
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Backend Configuration
BACKEND_PORT=8000
SECRET_KEY=insecure-dev-secret-change-in-production-random-32-chars
ENVIRONMENT=development

# Surveyor Licence (CRITICAL RULE 8: Must remain in config only, never committed)
IRDAI_LICENCE_NUMBER=

# Frontend Configuration
FRONTEND_PORT=5173

# Access password for the shared client login. Set a real one before deploying:
# in production and staging this is the ONLY password accepted.
APP_ACCESS_PASSWORD=

# Tally sheet reader (Google AI Studio key: https://aistudio.google.com/apikey).
# With a key set, the hosted vision model reads uploaded tally sheets. Without
# one the app falls back to local OCR, which does not cope with a sideways
# photo of a pen-filled form — expect to type most figures in.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Asked at the same time; the first to answer wins. Free-tier models are often
# busy (HTTP 503), and which one is busy changes hour to hour.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.8-flash,gemini-flash-latest,gemini-3.5-flash

# true  = send the whole sheet, so party name, container number, dates and
#         readings are filled in too.
# false = send only the number grid; the header stays on your server and those
#         six fields are typed by hand.
TALLY_CLOUD_SEND_FULL_SHEET=true

# The client's report archive (textcache/ and analysis/), used to build the
# standard wording for text sections. The client's own wording: keep it outside
# the repository.
CORPUS_DIR=
