#!/usr/bin/env bash
# ==============================================================================
# Marine Cargo Survey & QC Platform - Pre-commit Security & Hygiene Gate
# Enforces CRITICAL-RULES §8: Blocks IRDAI licence leaks & sample-data staging
# ==============================================================================

set -eo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Regex for IRDAI licence numbers (format: IRDA/IND/SLA-XXXXXX)
LICENCE_REGEX='IRDA/IND/SLA-[0-9]+'
BLOCKED=0

# Identify staged files (Added, Copied, Modified, Renamed)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

echo "[pre-commit] Scanning staged files for confidential data and licence patterns..."

for file in $STAGED_FILES; do
    # Skip agent metadata directory if staged
    if [[ "$file" =~ ^\.agents/ ]]; then
        continue
    fi

    # 1. Path check: Reject any file inside sample-data/ or variations anywhere in path
    if [[ "$file" =~ (^|/)sample[-_]?(data|reports)/ ]] || [[ "$file" =~ (^|/)samples/ ]]; then
        echo -e "${RED}[PRE-COMMIT BLOCKED] Prohibited sample data staged:${NC} $file"
        echo "Rule 8.1: No real sample data or reports may ever enter git history."
        BLOCKED=1
    fi

    # 2. Text inspection: Check staged content directly from git index
    if git show ":$file" 2>/dev/null | grep -i -E "$LICENCE_REGEX" > /dev/null 2>&1; then
        echo -e "${RED}[PRE-COMMIT BLOCKED] Prohibited IRDAI licence number pattern found in staged file:${NC} $file"
        MATCHES=$(git show ":$file" 2>/dev/null | grep -i -E -n "$LICENCE_REGEX" || true)
        echo "Matches:"
        echo "$MATCHES" | head -n 5 | sed 's/^/    /'
        echo "Rule 8.3: IRDAI licence numbers must reside in config/env vars, NEVER in committed code or templates."
        BLOCKED=1
    fi

    # 3. Binary / DOCX archive inspection: inspect word/document.xml and related parts
    if [[ "$file" =~ \.docx$ ]]; then
        if python3 -c "
import sys, io, zipfile, re
import xml.etree.ElementTree as ET

pattern = re.compile(r'IRDA/IND/SLA-\d+', re.IGNORECASE)
try:
    blob = sys.stdin.buffer.read()
    with zipfile.ZipFile(io.BytesIO(blob)) as z:
        for name in z.namelist():
            if name.endswith(('.xml', '.rels')):
                raw_bytes = z.read(name)
                txt = raw_bytes.decode('utf-8', errors='ignore')
                if pattern.search(txt):
                    sys.exit(1)
                try:
                    tree = ET.fromstring(raw_bytes)
                    all_t = ''.join(t.text or '' for t in tree.iter() if t.tag.endswith('}t') or t.tag == 't')
                    if pattern.search(all_t):
                        sys.exit(1)
                    for p in tree.iter():
                        if p.tag.endswith('}p') or p.tag == 'p':
                            p_txt = ''.join(t.text or '' for t in p.iter() if t.tag.endswith('}t') or t.tag == 't')
                            if pattern.search(p_txt):
                                sys.exit(1)
                except Exception:
                    pass
except Exception:
    pass
sys.exit(0)
" < <(git show ":$file" 2>/dev/null); then
            : # Clean
        else
            echo -e "${RED}[PRE-COMMIT BLOCKED] Prohibited IRDAI licence number pattern detected inside DOCX archive:${NC} $file"
            echo "Rule 8.3: Real client licence numbers must not exist inside committed Word templates."
            BLOCKED=1
        fi
    fi
done

if [ $BLOCKED -ne 0 ]; then
    echo -e "${RED}========================================================================${NC}"
    echo -e "${RED}COMMIT ABORTED: Security violations detected. Fix the issues and retry.${NC}"
    echo -e "${RED}========================================================================${NC}"
    exit 1
fi

echo -e "${GREEN}[pre-commit] Security scans passed successfully.${NC}"
exit 0
